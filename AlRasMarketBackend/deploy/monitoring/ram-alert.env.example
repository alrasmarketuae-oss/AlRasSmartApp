# Copy to ram-alert.env on the VPS and fill SMTP credentials.
# Do NOT commit ram-alert.env to git.

# 80-85% -> Warning email (no restart)
WARNING_THRESHOLD_PERCENT=80
WARNING_RESET_BELOW_PERCENT=78
WARNING_COOLDOWN_SECONDS=3600

# 90% sustained for 5 minutes -> Critical email (no restart)
CRITICAL_THRESHOLD_PERCENT=90
CRITICAL_SUSTAIN_SECONDS=300
CRITICAL_RESET_BELOW_PERCENT=85
CRITICAL_COOLDOWN_SECONDS=3600

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=alrasmarketuae@gmail.com
SENDER_PASSWORD=your-gmail-app-password
SENDER_NAME=Al Ras Server Monitor

ALERT_RECIPIENTS=nasermostafa.ma122@gmail.com,alrasmarketuae@gmail.com,merge.foodstuff.ae@gmail.com
