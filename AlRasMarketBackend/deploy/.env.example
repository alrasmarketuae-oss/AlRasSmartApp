# Copy to .env on the VPS and fill in real values.
# docker compose reads this automatically.

# SQL (keep current Site4Now DB, or move later)
DB_CONNECTION=Data Source=SQL5101.site4now.net;Initial Catalog=db_acbb76_alrasmarketua;User Id=db_acbb76_alrasmarketua_admin;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;

# Grafana (bound to 127.0.0.1 only — access via SSH tunnel)
GRAFANA_ADMIN_PASSWORD=changeme

# Optional overrides
# ASPNETCORE_ENVIRONMENT=Production
